{
  "scope": "Stage 1 Chinese-only calligraphy generation",
  "writer": "楷-赵孟俯三门记",
  "raw_root": "data/raw/extracted_calligrapher_dataset/chinese-calligraphy-dataset-with-calligrapher",
  "content_font_linux": "/usr/share/fonts/truetype/arphic/uming.ttc",
  "content_font_macos": "/System/Library/Fonts/Supplemental/Songti.ttc",
  "experiments": [
    {
      "name": "unet_l1_128_full",
      "gpu": 0,
      "model": "UNet L1",
      "image_size": 128,
      "batch_size": 32,
      "epochs": 100,
      "purpose": "Fast structure baseline"
    },
    {
      "name": "pix2pix_128_full",
      "gpu": 1,
      "model": "Pix2Pix PatchGAN",
      "image_size": 128,
      "batch_size": 24,
      "epochs": 100,
      "purpose": "Style strength comparison"
    },
    {
      "name": "unet_l1_256_full",
      "gpu": 2,
      "model": "UNet L1",
      "image_size": 256,
      "batch_size": 16,
      "epochs": 100,
      "purpose": "Clearer stroke and skeleton candidate"
    }
  ],
  "save_policy": "Save checkpoints and previews every epoch; inspect every 5 epochs and compare 20/50/100.",
  "stop_rule": "Stop a route if fixed boards get darker, blurrier, or structurally worse for 3 consecutive checkpoints."
}
